<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="katalog.AddScreen">
    <StackPanel Margin="24" Spacing="10" MaxWidth="440" HorizontalAlignment="Left">
        <TextBlock Text="Dodaj pozycję" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="Tytuł" />
        <TextBox x:Name="TitleInput" />
        <TextBlock Text="Rok wydania" />
        <TextBox x:Name="YearInput" />
        <TextBlock Text="Ocena (1–10)" />
        <TextBox x:Name="RatingInput" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnSaveClick">Zapisz</Button>
            <Button Click="OnCancelClick">Anuluj</Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
